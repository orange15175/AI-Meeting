# 复制为 .env 后按需修改；.env 已加入 .gitignore，不要提交真实密钥。
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.2
BUILDER_IMAGE=maven:3.9.11-eclipse-temurin-17
RUNTIME_IMAGE=eclipse-temurin:17-jre-jammy

MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=mainshi_agent

# 直连大模型（出题/评分/追问与普通聊天统一走 ai-meeting.llm.*）。
# LLM_API_KEY 必填：未填写时应用可启动，但所有模型调用会失败。
# 切换 Qwen：LLM_PROVIDER=qwen，LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1，LLM_MODEL=qwen-plus
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat

# 视觉模型（图片简历 / 扫描版 PDF 识别，OpenAI 兼容多模态协议）。
# 地址和模型已按千问 MaaS 预置；只需填入 VISION_API_KEY 即可启用。
# 留空时应用照常启动，仅图片/扫描件识别不可用，文本 PDF 不受影响。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.8-omni-flash
VISION_API_KEY=your-vision-api-key

# 出题（可选）：默认题量、允许区间、单次调用超时与输出预算。
# 请求里的 questionCount 优先于 INTERVIEW_QUESTION_COUNT；区间用于拒绝越界入参。
# 改动超时前先确认重操作锁租期仍能覆盖 2 × timeout。
# INTERVIEW_QUESTION_COUNT=10
# INTERVIEW_QUESTION_COUNT_MIN=5
# INTERVIEW_QUESTION_COUNT_MAX=20
# INTERVIEW_EXTRACTION_TIMEOUT_MILLIS=90000
# INTERVIEW_EXTRACTION_TOKENS_PER_QUESTION=400
# INTERVIEW_EXTRACTION_TOKENS_FLOOR=4096
# INTERVIEW_EXTRACTION_TOKENS_CEILING=8192

# 监控（可选）：不填则用 compose 内的默认值，仅供本地开发。
# 上线前务必改掉默认密码，Grafana 的 3000 端口也不应直接暴露到公网。
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
